{
    "name": "bt-manager",
    "version": "0.1.0-alpha",
    "description": "BattleTech Campaign Manager Desktop App by Lüdinn Entertainment",
    "author": "Lüdinn Entertainment",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build:electron": "npm run build:web && electron-builder",
        "build:web": "cd apps/web && npm run build",
        "build": "npm run build:web && electron-builder"
    },
    "build": {
        "appId": "com.ludinn.btmanager",
        "productName": "BT-Manager",
        "copyright": "Copyright © 2026 Lüdinn Entertainment",
        "directories": {
            "output": "dist"
        },

        "files": [
            "main.js",
            "apps/web/out/**/*"
        ],
        "extraResources": [
            {
                "filter": [
                    "**/*"
                ],
                "from": "dist/main",
                "to": "extra/main"
            }
        ],
        "asar": true,
        "nsis": {
            "oneClick": false,
            "runAfterFinish": true,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "BT-Manager",
            "uninstallDisplayName": "BT-Manager",
            "perMachine": false
        }
    },
    "dependencies": {
        "tree-kill": "^1.2.2"
    },
    "devDependencies": {
        "electron": "^43.2.0",
        "electron-builder": "^24.0.0"
    }
}
